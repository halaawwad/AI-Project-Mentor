# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after changes.
# WARNING: VITE_ variables are bundled into the browser JavaScript. Anyone who can load the
# app can read this key. Use it only for this private prototype, with a key you can revoke.
VITE_GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
VITE_GEMINI_MODEL=
